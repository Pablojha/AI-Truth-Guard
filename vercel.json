{
  "version": 2,
  "outputDirectory": "app/static",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ai-truth-guard.onrender.com/api/:path*" },
    { "source": "/v1/:path*", "destination": "https://ai-truth-guard.onrender.com/v1/:path*" },
    { "source": "/readyz", "destination": "https://ai-truth-guard.onrender.com/readyz" },
    { "source": "/healthz", "destination": "https://ai-truth-guard.onrender.com/healthz" },
    { "source": "/metrics", "destination": "https://ai-truth-guard.onrender.com/metrics" }
  ]
}
