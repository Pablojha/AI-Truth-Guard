# TruthGuard configuration template. Copy to .env and fill in your own values.
# Never commit real secrets.

# Verification provider: "websearch" (evidence-based, recommended) or "fixture" (demo)
PROVIDER_MODE=websearch

# Set to "production" on Render. Enables secure cookies and startup checks.
ENVIRONMENT=development

# Database.
# Local: SQLite file. Production: PostgreSQL URL from Neon (ends with sslmode=require).
DATABASE_URL=sqlite:///./truthguard.db

# Security: required in production. Use a long random value.
SECRET_KEY=change-me-to-a-long-random-value
ADMIN_TOKEN=change-me-to-a-different-random-value

# Payments (UPI)
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=AI TruthGuard

# CORS origins allowed to call the API directly (the Vercel frontend calls through a proxy)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Corpus and prompt versions
CORPUS_VERSION=v0.1
PROMPT_VERSION=v0.1

# Limits
MAX_INPUT_LENGTH=5000
MAX_CLAIMS_PER_REQUEST=20
REQUEST_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO

# Ollama (only used when PROVIDER_MODE=local)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
