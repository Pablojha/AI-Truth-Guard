# TruthGuard Configuration

# Provider mode: "local" (Ollama) or "fixture" (demo)
PROVIDER_MODE=local

# Ollama API endpoint
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Corpus and Prompt Versions
CORPUS_VERSION=v0.1
PROMPT_VERSION=v0.1

# Limits
MAX_INPUT_LENGTH=5000
MAX_CLAIMS_PER_REQUEST=20
REQUEST_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO

# CORS (for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
